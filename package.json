{
  "name": "what2watch",
  "version": "1.0.0",
  "description": "A client-side movie discovery, recommendation, and tracking web application built with vanilla JavaScript, powered by a daily-updated movie dataset from [The Movie Database (TMDB)](https://www.themoviedb.org/).",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.js",
    "eval": "vitest run tests/evaluate.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JTamag/What2Watch.git"
  },
