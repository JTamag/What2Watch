  "type": "module",
  "bugs": {
    "url": "https://github.com/JTamag/What2Watch/issues"
  },
  "homepage": "https://github.com/JTamag/What2Watch#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
